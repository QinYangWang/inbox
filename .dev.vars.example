# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Random 256-bit master secrets. V1 is required; add V2 only when rotating.
# Generate each value with: openssl rand -base64 32
DOMAIN_ENCRYPTION_MASTER_V1=replace-with-random-base64-secret
# DOMAIN_ENCRYPTION_MASTER_V2=replace-with-a-different-random-base64-secret
